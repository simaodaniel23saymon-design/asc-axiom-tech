# ASC Axiom Tech — variáveis de ambiente
# Copia este ficheiro para .env.local e preenche os valores reais

# Database
DATABASE_URL=postgres://username:password@host:5432/database?sslmode=require

# Initial admin seed (required only when creating the first login user)
ADMIN_INITIAL_EMAIL=admin@ascaxiomtech.com
ADMIN_INITIAL_PASSWORD=

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_TO_EMAIL=hello@yourdomain.com
RESEND_CONTACT_TO_EMAIL=hello@yourdomain.com
RESEND_INVESTORS_TO_EMAIL=hello@yourdomain.com

# Analytics — Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel
NEXT_PUBLIC_META_PIXEL=PIXEL_ID
